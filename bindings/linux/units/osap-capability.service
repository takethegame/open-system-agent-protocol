[Unit]
Description=OSAP capability authority
Documentation=https://github.com/takethegame/open-system-agent-protocol
Requires=osap-bus.service
After=osap-bus.service
PartOf=osap-bus.service

[Service]
Type=dbus
BusName=org.osap.Capability
ExecStart=/usr/libexec/osap-capability
Restart=on-failure
RestartSec=2s
StateDirectory=osap
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any

[Install]
WantedBy=default.target
